
{
  "manifest_version": 3,
  "name": "WhatsApp Themes",
  "version": "1.0",
  "description": "Revamp the appearance of WhatsApp Web",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "permissions": ["tabs", "storage"],

  "host_permissions": ["https://web.whatsapp.com/*"],

  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": ["style.css"],
      "js": ["themes.js", "styles.js", "content.js"]
    }
  ]
}
